{
  "name": "embrace-web-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "npx -y lefthook install -f",
    "clean": "node scripts/emb-rm.js '**/.turbo' '**/.next' '**/dist' '**/node_modules'",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "turbo run check",
    "validate:versions": "node scripts/validate-versions.js",
    "validate": "npm run validate:versions && npm run licenses:check && turbo run validate",
    "licenses": "patch-package && turbo run licenses",
    "licenses:check": "npm run licenses && git diff --exit-code -- packages/web-sdk/THIRD_PARTY_NOTICES.txt packages/web-cli/THIRD_PARTY_NOTICES.txt",
    "dev": "turbo run dev --filter=embrace-web-sdk-react-demo...",
    "demo": "npm i && npm run demo -w demo/frontend",
    "server": "npx tsx server/server.ts",
    "commitlint": "commitlint",
    "test:integration": "turbo run test --filter=tests-integration",
    "test:integration:headed": "turbo run test:headed --filter=tests-integration",
    "test:integration:update-golden": "turbo run update-golden --filter=tests-integration",
    "test:integration:container": "bash scripts/test-integration-podman.sh",
    "test:integration:container:update-golden": "UPDATE_GOLDEN=1 bash scripts/test-integration-podman.sh",
    "test:integration:container:serve": "bash scripts/e2e-serve.sh",
    "test:integration:container:test": "bash scripts/e2e-test.sh",
    "test:integration:container:test:update-golden": "UPDATE_GOLDEN=1 bash scripts/e2e-test.sh",
    "test:integration:container:stop": "bash scripts/e2e-stop.sh",
    "test:multiBrowsers": "turbo run test:multiBrowsers --filter=@embrace-io/web-sdk",
    "test:performance": "npm run test --prefix tests/performance"
  },
  "workspaces": [
    "packages/*",
    "demo/*",
    "scripts",
    "server",
    "tests/integration"
  ],
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@biomejs/biome": "2.5.5",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@opentelemetry/otlp-transformer": "0.221.0",
    "@playwright/test": "1.62.1",
    "@remcovaes/web-test-runner-vite-plugin": "1.4.1",
    "@types/chai": "5.2.3",
    "@types/chrome-remote-interface": "0.34.0",
    "@types/history": "4.7.11",
    "@types/hoist-non-react-statics": "3.3.7",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/react-router-domv4v5": "npm:@types/react-router-dom@5.3.3",
    "@types/sinon": "22.0.0",
    "@types/sinon-chai": "4.0.0",
    "@web/test-runner": "1.0.0",
    "@web/test-runner-playwright": "1.0.0",
    "chai": "6.2.2",
    "chrome-launcher": "1.2.1",
    "chrome-remote-interface": "0.34.0",
    "embrace-web-monorepo-scripts": "*",
    "es-check": "9.6.4",
    "eslint": "10.8.0",
    "eslint-plugin-baseline-js": "0.7.0",
    "generate-license-file": "4.2.1",
    "globals": "17.8.0",
    "history": "4.10.1",
    "jest-diff": "30.4.1",
    "lefthook": "2.1.10",
    "patch-package": "8.0.1",
    "picocolors": "1.1.1",
    "playwright": "1.62.1",
    "publint": "0.3.22",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-domv4v5": "npm:react-router-dom@5.3.4",
    "react-router-domv6plus": "npm:react-router-dom@7.18.1",
    "sinon": "22.1.0",
    "sinon-chai": "4.0.1",
    "sonda": "0.14.0",
    "terser": "5.49.0",
    "tsdown": "0.22.14",
    "tsx": "4.23.1",
    "turbo": "2.10.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0"
  },
  "overrides": {
    "fast-uri": "^4.1.1"
  },
  "packageManager": "npm@11.16.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.16.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24 || ^26.3.0"
    }
  },
  "allowScripts": {
    "lefthook@2.1.8": true
  }
}
