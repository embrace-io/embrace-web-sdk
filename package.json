{
  "name": "@embrace-io/web-sdk",
  "version": "2.3.2",
  "description": "Embrace Web SDK",
  "type": "module",
  "jsdelivr": "./dist/embrace-web-sdk.js",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "prepublishOnly": "npm run compile && npm run validate",
    "clean": "npm run clean --workspaces --if-present; npx rimraf {,**/}.sonda {,**/}build {,**/}dist {,**/}node_modules",
    "compile": "npm run sdk:compile && npm run compile --workspaces --if-present",
    "lint": "npm run sdk:lint:fix",
    "validate": "npm run sdk:validate && npm run cli:validate",
    "dev": "npm run dev --workspace=embrace-web-sdk-react-demo",
    "demo": "npm run demo --workspace=embrace-web-sdk-react-demo",
    "sdk:docs": "npx typedoc --readme none && touch docs/.nojekyll",
    "sdk:test": "web-test-runner",
    "sdk:test:manual": "npm run sdk:test -- --manual",
    "sdk:test:coverage": "npm run sdk:test -- --config=web-test-runner.coverage.config.js",
    "sdk:test:multiBrowsers": "npm run sdk:test -- --config=web-test-runner.multi-browser.config.js",
    "sdk:test:performance": "npm run test --prefix tests/performance",
    "sdk:test:integration": "npm run compile && npm run sdk:test:integration:e2e:install-dependencies && npm run sdk:test:integration:build && npm run sdk:test:integration:e2e",
    "sdk:test:integration:build": "npm run tests:integration:build --prefix tests/integration",
    "sdk:test:integration:e2e": "npm run tests:integration:e2e --prefix tests/integration",
    "sdk:test:integration:e2e:install-dependencies": "bash scripts/installE2EPlatformDependencies.sh",
    "sdk:test:integration:e2e:update-golden": "npm run tests:integration:e2e:update-golden --prefix tests/integration",
    "sdk:test:watch": "npm run sdk:test -- --watch",
    "sdk:compile": "npx rimraf dist && npm run sdk:compile:iife && npm run sdk:compile:sdk",
    "sdk:compile:iife": "esbuild src/index.ts --bundle --format=iife --global-name=EmbraceWebSDK --target=es6 --sourcemap --outfile=dist/embrace-web-sdk.js && terser dist/embrace-web-sdk.js -c -m --source-map \"content='dist/embrace-web-sdk.js.map',url='embrace-web-sdk.js.map'\" -o dist/embrace-web-sdk.js",
    "sdk:compile:iife:watch": "esbuild src/index.ts --bundle --format=iife --global-name=EmbraceWebSDK --target=es6 --sourcemap --outfile=dist/embrace-web-sdk.js --watch",
    "sdk:compile:sdk": "tsc -p tsconfig.build.json",
    "sdk:compile:sdk:watch": "tsc --watch -p tsconfig.build.json",
    "sdk:lint": "npm run sdk:lint:prettier && npm run sdk:lint:eslint && npm run sdk:tsc:check",
    "sdk:lint:fix": "npm run sdk:lint:prettier:fix && npm run sdk:tsc:check && npm run sdk:lint:eslint:fix",
    "sdk:lint:prettier": "prettier --log-level=warn --check .",
    "sdk:lint:prettier:fix": "prettier --log-level=warn --write .",
    "sdk:lint:eslint": "eslint --max-warnings=0",
    "sdk:lint:eslint:fix": "eslint --fix --max-warnings=0 --no-warn-ignored",
    "sdk:tsc:check": "tsc",
    "sdk:validate": "bash scripts/validate-build.sh",
    "cli:validate": "npm run validate --prefix cli",
    "commitlint": "commitlint",
    "playwright": "playwright",
    "prepare": "if [ -d .git ]; then husky; fi"
  },
  "files": [
    "dist",
    "LICENSE",
    "*.md",
    "!CLAUDE.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./react-instrumentation": "./dist/react-instrumentation/index.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "react-instrumentation": [
        "./dist/react-instrumentation/index.d.ts"
      ]
    }
  },
  "author": "Embrace <support@embrace.io> (https://embrace.io/)",
  "bugs": {
    "url": "https://github.com/embrace-io/embrace-web-sdk/issues",
    "email": "support@embrace.io"
  },
  "homepage": "https://github.com/embrace-io/embrace-web-sdk",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embrace-io/embrace-web-sdk.git"
  },
  "keywords": [
    "embrace",
    "web",
    "tracking",
    "observability",
    "otel",
    "instrumentation",
    "telemetry"
  ],
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.205.0",
    "@opentelemetry/core": "2.1.0",
    "@opentelemetry/instrumentation": "0.205.0",
    "@opentelemetry/instrumentation-fetch": "0.205.0",
    "@opentelemetry/instrumentation-xml-http-request": "0.205.0",
    "@opentelemetry/otlp-exporter-base": "0.205.0",
    "@opentelemetry/otlp-transformer": "0.205.0",
    "@opentelemetry/resources": "2.1.0",
    "@opentelemetry/sdk-logs": "0.205.0",
    "@opentelemetry/sdk-trace-web": "2.1.0",
    "@opentelemetry/semantic-conventions": "1.37.0",
    "@opentelemetry/web-common": "0.205.0",
    "hoist-non-react-statics": "3.3.2",
    "uuid": "11.1.0",
    "web-vitals": "5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@remcovaes/web-test-runner-vite-plugin": "1.3.0",
    "@swc/core": "1.13.5",
    "@types/chai": "5.2.2",
    "@types/chrome-remote-interface": "0.31.14",
    "@types/hoist-non-react-statics": "3.3.7",
    "@types/mocha": "10.0.10",
    "@types/node": "22.18.4",
    "@types/react": "19.1.13",
    "@types/sinon": "17.0.4",
    "@types/sinon-chai": "4.0.0",
    "@web/test-runner": "0.20.2",
    "@web/test-runner-playwright": "0.11.1",
    "chai": "6.0.1",
    "chrome-launcher": "1.2.0",
    "chrome-remote-interface": "0.33.3",
    "es-check": "9.3.1",
    "esbuild": "0.25.10",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prefer-arrow-functions": "3.8.1",
    "eslint-plugin-regex": "1.10.0",
    "eslint-plugin-require-extensions": "0.1.3",
    "get-port": "7.1.0",
    "globals": "16.3.0",
    "husky": "9.1.7",
    "jest-diff": "30.1.2",
    "lighthouse": "12.8.2",
    "nano-staged": "0.8.0",
    "playwright": "1.55.1",
    "prettier": "3.6.2",
    "publint": "0.3.13",
    "rimraf": "6.0.1",
    "sinon-chai": "4.0.1",
    "terser": "5.44.0",
    "tsx": "4.20.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.44.1"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "workspaces": [
    "cli",
    "demo/frontend",
    "demo/frontend-cdn",
    "demo/frontend-sdk",
    "tests/performance",
    "tests/integration"
  ],
  "nano-staged": {
    "*.{ts,tsx,js,jsx,mjs,yml,yaml,html}": "npm run lint"
  },
  "engines": {
    "node": ">=20",
    "npm": "11.4.2"
  }
}
