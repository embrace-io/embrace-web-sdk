{
  "name": "embrace-web-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "npx -y lefthook install -f",
    "clean": "npx rimraf -g \"**/.turbo\" \"**/.next\" \"**/dist\" \"**/node_modules\"",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "turbo run check",
    "validate:versions": "node scripts/validate-versions.js",
    "validate": "npm run validate:versions && turbo run validate",
    "dev": "turbo run dev --filter=embrace-web-sdk-react-demo",
    "demo": "npm run demo -w demo/frontend",
    "server": "npx tsx server/server.ts",
    "commitlint": "commitlint",
    "test:integration": "turbo run test --filter=tests-integration",
    "test:integration:update-golden": "turbo run update-golden --filter=tests-integration",
    "test:performance": "turbo run test --filter=tests-performance",
    "test:multiBrowsers": "turbo run test:multiBrowsers --filter=@embrace-io/web-sdk"
  },
  "workspaces": [
    "packages/*",
    "demo/*",
    "tests/integration",
    "tests/performance"
  ],
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.2",
    "@biomejs/biome": "2.3.15",
    "@commitlint/cli": "20.4.1",
    "@commitlint/config-conventional": "20.4.1",
    "@playwright/test": "1.58.2",
    "@types/chrome-remote-interface": "0.33.0",
    "@types/node": "24.10.0",
    "chrome-launcher": "1.2.1",
    "chrome-remote-interface": "0.34.0",
    "es-check": "9.5.4",
    "eslint": "9.39.2",
    "eslint-plugin-baseline-js": "0.5.0",
    "get-port": "7.1.0",
    "globals": "17.3.0",
    "jest-diff": "30.2.0",
    "lefthook": "2.1.1",
    "lighthouse": "13.0.3",
    "playwright": "1.58.2",
    "publint": "0.3.17",
    "rimraf": "6.1.2",
    "sonda": "0.10.2",
    "terser": "5.46.0",
    "tsdown": "0.20.3",
    "tsx": "4.21.0",
    "turbo": "2.8.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0"
  },
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
