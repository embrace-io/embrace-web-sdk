{
  "name": "embrace-web-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "npx -y lefthook install -f",
    "clean": "npx -y rimraf -g \"**/.turbo\" \"**/.next\" \"**/dist\" \"**/node_modules\"",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "turbo run check",
    "validate:versions": "node scripts/validate-versions.js",
    "validate": "npm run validate:versions && turbo run validate",
    "dev": "turbo run dev --filter=embrace-web-sdk-react-demo...",
    "demo": "npm i && npm run demo -w demo/frontend",
    "server": "npx tsx server/server.ts",
    "commitlint": "commitlint",
    "test:integration": "turbo run test --filter=tests-integration",
    "test:integration:update-golden": "turbo run update-golden --filter=tests-integration",
    "test:integration:container": "bash scripts/test-integration-podman.sh",
    "test:integration:container:update-golden": "UPDATE_GOLDEN=1 bash scripts/test-integration-podman.sh",
    "test:integration:container:serve": "bash scripts/e2e-serve.sh",
    "test:integration:container:test": "bash scripts/e2e-test.sh",
    "test:integration:container:test:update-golden": "UPDATE_GOLDEN=1 bash scripts/e2e-test.sh",
    "test:integration:container:stop": "bash scripts/e2e-stop.sh",
    "test:performance": "turbo run test --filter=tests-performance",
    "test:multiBrowsers": "turbo run test:multiBrowsers --filter=@embrace-io/web-sdk"
  },
  "workspaces": [
    "packages/*",
    "demo/*",
    "tests/integration",
    "tests/performance"
  ],
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.2",
    "@biomejs/biome": "2.4.8",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@opentelemetry/otlp-transformer": "0.213.0",
    "@playwright/test": "1.58.2",
    "@remcovaes/web-test-runner-vite-plugin": "1.4.0",
    "@types/chai": "5.2.3",
    "@types/chrome-remote-interface": "0.33.0",
    "@types/hoist-non-react-statics": "3.3.7",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sinon": "21.0.0",
    "@types/sinon-chai": "4.0.0",
    "@web/test-runner": "0.20.2",
    "@web/test-runner-playwright": "0.11.1",
    "chai": "6.2.2",
    "chrome-launcher": "1.2.1",
    "chrome-remote-interface": "0.34.0",
    "es-check": "9.6.3",
    "eslint": "10.1.0",
    "eslint-plugin-baseline-js": "0.6.1",
    "globals": "17.4.0",
    "jest-diff": "30.3.0",
    "lefthook": "2.1.4",
    "picocolors": "1.1.1",
    "playwright": "1.58.2",
    "publint": "0.3.18",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rimraf": "6.1.3",
    "sinon": "21.0.3",
    "sinon-chai": "4.0.1",
    "sonda": "0.11.1",
    "terser": "5.46.1",
    "tsdown": "0.21.4",
    "tsx": "4.21.0",
    "turbo": "2.8.20",
    "typescript": "6.0.2",
    "typescript-eslint": "8.57.1",
    "vite": "8.0.1"
  },
  "overrides": {
    "typescript": "6.0.2",
    "@remcovaes/web-test-runner-vite-plugin": {
      "vite": "8.0.1"
    }
  },
  "packageManager": "npm@11.9.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.9.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24"
    }
  }
}
