{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "useIgnoreFile": true,
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!!**/__golden__",
      "!!tests/integration/server/public"
    ]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "recommended": true,
      "complexity": {
        // https://github.com/biomejs/biome/discussions/7404
        "useLiteralKeys": "off",
        "useArrowFunction": "error"
      },
      "correctness": {
        "noNodejsModules": "error"
        // TBD on whether to use ts or js extensions
        // "useImportExtensions": "error"
        // https://github.com/biomejs/biome/issues/7734
        // "useImportExtensions": {
        //   "level": "error",
        //   "options": {
        //     "forceJsExtensions": true  // Force .js even for .ts files
        //   }
        // }
      },
      "performance": {
        "noReExportAll": "error"
      },
      "style": {
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        },
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn", "info"]
          }
        }
      }
    }
  }
}
