{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "useIgnoreFile": true,
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!!**/.next",
      "!!**/.turbo",
      "!!**/__golden__",
      "!!**/dist",
      "!!**/public"
    ]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      // webpack integration tests use tailwind
      "tailwindDirectives": true
    }
  },
  "linter": {
    "domains": {
      "playwright": "all",
      "project": "recommended",
      "react": "all",
      "test": "all",
      "turborepo": "all",
      "types": "all"
    },
    "rules": {
      "security": {
        "recommended": true
      },
      "a11y": "error",
      "complexity": {
        "recommended": true,
        // https://github.com/biomejs/biome/discussions/7404
        "useLiteralKeys": "off",
        // API classes use static-only pattern to match OTel conventions
        "noStaticOnlyClass": "off"
      },
      "correctness": {
        "recommended": true,
        "useImportExtensions": "error"
      },
      "performance": {
        "recommended": true,
        "noReExportAll": "error",
        "noBarrelFile": "error"
      },
      "style": {
        "recommended": true,
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        },
        "useNodejsImportProtocol": {
          "level": "error",
          "fix": "unsafe"
        },
        // allow self-contained react component files
        "useComponentExportOnlyModules": "off"
      },
      "suspicious": {
        "recommended": true,
        "noImportCycles": "error"
        // turn on when we are ready to use all new OTel semantic conventions
        // "noDeprecatedImports": "warn"
      },
      "nursery": {
        "recommended": true
      }
    }
  }
}
