{
  "name": "frontend-sdk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm install && bash scripts/setupBundleSymLinks.sh",
    "build": "npm run build --workspaces",
    "dev": "cd host && npm run dev",
    "serve": "cd host && npx serve dist"
  },
  "dependencies": {
    "@opentelemetry/sdk-logs": "0.205.0",
    "@opentelemetry/sdk-trace-web": "2.1.0"
  },
  "workspaces": [
    "sdk",
    "host"
  ]
}
