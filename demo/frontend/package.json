{
  "name": "embrace-web-sdk-react-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --build",
    "clean": "emb-rm .sonda dist",
    "dev": "vite --port 4847 --open",
    "build": "vite build",
    "preview": "vite preview --port 4847 --open",
    "demo": "bash ./scripts/runDemo.sh",
    "upload-sourcemaps": "embrace-web-cli upload --app-version 0.0.1",
    "upload-sourcemaps:dry": "embrace-web-cli upload -d --app-version 0.0.1"
  },
  "dependencies": {
    "@embrace-io/web-sdk": "*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@opentelemetry/sdk-trace-web": "^2.9.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@embrace-io/web-cli": "*"
  }
}
