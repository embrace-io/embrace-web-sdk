{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "clean": {
      "cache": false
    },
    "build": {
      "dependsOn": ["clean", "^build"],
      "cache": false
    },
    "preview": {
      "with": ["//#server"],
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "with": ["//#server"],
      "cache": false,
      "persistent": true,
      "interactive": true
    }
  }
}
