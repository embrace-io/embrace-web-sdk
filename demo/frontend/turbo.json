{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["clean", "^build"],
      "cache": false
    },
    "preview": {
      "with": ["//#server"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "with": ["//#server"],
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
