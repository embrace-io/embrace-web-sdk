{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "schedule": ["before 3am on Monday"],
  "prConcurrentLimit": 5,
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "description": "OpenTelemetry packages - group together",
      "matchPackagePatterns": ["^@opentelemetry/"],
      "groupName": "OpenTelemetry"
    },
    {
      "description": "Production dependencies - group for review",
      "matchDepTypes": ["dependencies"],
      "excludePackagePatterns": ["^@opentelemetry/"],
      "groupName": "production-deps"
    },
    {
      "description": "Patch versions - group together",
      "groupName": "all patch versions",
      "groupSlug": "all-patch",
      "matchUpdateTypes": ["patch"]
    },
    {
      "description": "react-router-dom - prevent major updates",
      "matchPackagePatterns": ["^react-router-dom"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Peer dependencies - do not update",
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": { "enabled": true },
  "rebaseWhen": "conflicted",
  "ignoreDeps": ["@types/node", "node", "npm"],
  "labels": ["dependencies"],
  "postUpdateOptions": ["npmDedupe"]
}
