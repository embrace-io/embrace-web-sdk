{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "schedule": ["before 8am on Monday"],
  "rebaseWhen": "behind-base-branch",
  "ignorePaths": ["tests/integration/platforms/**"],
  "ignoreDeps": ["@types/node", "node", "npm"],
  "labels": ["dependencies"],
  "postUpdateOptions": ["npmDedupe"],
  "rangeStrategy": "bump",
  "separateMajorMinor": false,
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "All dependencies",
      "matchDepTypes": ["dependencies", "devDependencies"],
      "groupName": "dependencies"
    },
    {
      "description": "OpenTelemetry",
      "matchDepNames": ["@opentelemetry/**"],
      "groupName": "opentelemetry"
    },
    {
      "description": "React - prevent major updates",
      "matchDepNames": [
        "history",
        "react",
        "react-dom",
        "react-router-domv4v5",
        "react-router-domv6plus",
        "@types/history",
        "@types/react",
        "@types/react-dom",
        "@types/react-router-domv4v5"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "TypeScript - stay on 6.x",
      "matchDepNames": ["typescript"],
      "allowedVersions": "^6"
    },
    {
      "description": "Playwright",
      "matchDepNames": [
        "@playwright/test",
        "mcr.microsoft.com/playwright",
        "playwright"
      ],
      "groupName": "playwright"
    },
    {
      "description": "Peer dependencies - do not update",
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    }
  ]
}
