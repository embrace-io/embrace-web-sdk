{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "schedule": ["before 3am on Monday"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "rebaseWhen": "behind-base-branch",
  "ignorePaths": ["tests/integration/platforms/**"],
  "ignoreDeps": ["@types/node", "node", "npm"],
  "labels": ["dependencies"],
  "postUpdateOptions": ["npmDedupe"],
  "packageRules": [
    {
      "description": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Production dependencies (excludes OTel)",
      "matchDepTypes": ["dependencies"],
      "excludeDepNames": ["/^@opentelemetry\\//"],
      "groupName": "production-deps"
    },
    {
      "description": "Dev minor and patches",
      "matchDepTypes": ["devDependencies"],
      "groupName": "dev-deps"
    },
    {
      "description": "Dev major",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["major"],
      "groupName": "dev-deps-major"
    },
    {
      "description": "OpenTelemetry",
      "matchDepNames": ["/^@opentelemetry\\//"],
      "groupName": "opentelemetry"
    },
    {
      "description": "Playwright group",
      "matchDepNames": ["@playwright/test", "playwright"],
      "groupName": "playwright"
    },
    {
      "description": "ESLint group",
      "matchDepNames": ["typescript-eslint", "/^eslint/", "/^@eslint\\//"],
      "groupName": "eslint"
    },
    {
      "description": "React group",
      "matchDepNames": [
        "react",
        "react-dom",
        "react-router-domv4v5",
        "react-router-domv6plus",
        "@types/react",
        "@types/react-dom",
        "@types/react-router-domv4v5"
      ],
      "groupName": "react"
    },
    {
      "description": "React - prevent major updates",
      "matchDepNames": [
        "react",
        "react-dom",
        "react-router-domv4v5",
        "react-router-domv6plus",
        "@types/react",
        "@types/react-dom",
        "@types/react-router-domv4v5"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Web Test Runner group",
      "matchDepNames": [
        "/^@web\\/test-runner/",
        "/^@remcovaes\\/web-test-runner/"
      ],
      "groupName": "web-test-runner"
    },
    {
      "description": "Commitlint group",
      "matchDepNames": ["/^@commitlint\\//"],
      "groupName": "commitlint"
    },
    {
      "description": "Demo backend group",
      "matchFileNames": ["demo/backend/**"],
      "groupName": "demo-backend"
    },
    {
      "description": "Peer dependencies - do not update",
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    }
  ]
}
