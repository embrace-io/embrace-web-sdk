{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "schedule": [
    "before 3am on Monday"
  ],
  "prConcurrentLimit": 5,
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "description": "OpenTelemetry packages - group together",
      "matchPackageNames": [
        "/^@opentelemetry\\//"
      ],
      "groupName": "OpenTelemetry"
    },
    {
      "description": "Production dependencies - group for review",
      "matchDepTypes": [
        "dependencies"
      ],
      "groupName": "production-deps",
      "matchPackageNames": [
        "!/^@opentelemetry\\//"
      ]
    },
    {
      "description": "Playwright - keep in sync",
      "matchPackageNames": [
        "@playwright/test",
        "playwright"
      ],
      "groupName": "playwright"
    },
    {
      "description": "TypeScript tooling - group together",
      "matchPackageNames": [
        "typescript",
        "typescript-eslint"
      ],
      "groupName": "typescript"
    },
    {
      "description": "React - group together",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "react"
    },
    {
      "description": "Web Test Runner - group together",
      "matchPackageNames": [
        "/^@web\\/test-runner/",
        "/^@remcovaes\\/web-test-runner/"
      ],
      "groupName": "web-test-runner"
    },
    {
      "description": "Commitlint - group together",
      "matchPackageNames": [
        "/^@commitlint\\//"
      ],
      "groupName": "commitlint"
    },
    {
      "description": "DevDependencies patches - automerge",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "react-router-dom - prevent major updates",
      "matchPackageNames": [
        "react-router-dom"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Peer dependencies - do not update",
      "matchDepTypes": [
        "peerDependencies"
      ],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "rebaseWhen": "conflicted",
  "ignoreDeps": [
    "@types/node",
    "node",
    "npm"
  ],
  "labels": [
    "dependencies"
  ],
  "postUpdateOptions": [
    "npmDedupe"
  ]
}
