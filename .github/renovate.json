{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "schedule": ["before 8am on Monday"],
  "rebaseWhen": "behind-base-branch",
  "ignorePaths": ["tests/integration/platforms/**"],
  "ignoreDeps": ["@types/node", "node", "npm"],
  "labels": ["dependencies"],
  "postUpdateOptions": ["npmDedupe"],
  "rangeStrategy": "bump",
  "separateMajorMinor": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/",
        "/(^|/)manifest\\.yaml$/",
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+WEAVER_VERSION=(?<currentValue>\\S+)",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+OPA_VERSION=(?<currentValue>\\S+)",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+ref=(?<currentValue>\\S+)\\s+POLICY_REPO_URL=(?<packageName>\\S+)\\s+POLICY_REPO_REF=(?<currentDigest>\\S+)",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+- schema_url: https://opentelemetry\\.io/schemas/(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+- schema_url: \\S+\\s+registry_path:.*?@(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\[model\\]",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+SOURCE_REGISTRY := \\S+@(?<currentValue>v[^\\[\\s]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Bump the core registry dependency everywhere at once",
      "matchDepNames": ["open-telemetry/semantic-conventions"],
      "groupName": "core registry"
    },
    {
      "description": "All dependencies",
      "matchDepTypes": ["dependencies", "devDependencies"],
      "groupName": "dependencies"
    },
    {
      "description": "OpenTelemetry",
      "matchDepNames": ["@opentelemetry/**"],
      "groupName": "opentelemetry"
    },
    {
      "description": "React - prevent major updates",
      "matchDepNames": [
        "history",
        "react",
        "react-dom",
        "react-router-domv4v5",
        "react-router-domv6plus",
        "@types/history",
        "@types/react",
        "@types/react-dom",
        "@types/react-router-domv4v5"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "TypeScript - stay on 6.x",
      "matchDepNames": ["typescript"],
      "allowedVersions": "^6"
    },
    {
      "description": "Playwright",
      "matchDepNames": [
        "@playwright/test",
        "mcr.microsoft.com/playwright",
        "playwright"
      ],
      "groupName": "playwright"
    },
    {
      "description": "Peer dependencies - do not update",
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    }
  ]
}
