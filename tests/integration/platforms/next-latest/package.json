{
  "name": "next-latest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint",
    "build": "npm run build:clean && npm run build:es2020",
    "build:clean": "npx rimraf .next",
    "build:es2020": "next build && npm run process-sourcemaps",
    "process-sourcemaps": "embrace-web-cli upload -a NOEMB -p ./.next/static/chunks --no-upload"
  },
  "dependencies": {
    "@embrace-io/web-sdk": "file:../../../..",
    "next": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@embrace-io/web-cli": "file:../../../../cli",
    "@eslint/eslintrc": "^3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "latest",
    "typescript": "^5"
  }
}
