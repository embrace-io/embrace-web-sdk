{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.esnext.ts",
    "build": "npm run build:clean && npm run build:esnext && npm run build:es2015",
    "build:clean": "npx rimraf dist .sonda",
    "build:esnext": "vite build --config vite.config.esnext.ts && npm run process-sourcemaps:esnext",
    "build:es2015": "vite build --config vite.config.es2015.ts && npm run process-sourcemaps:es2015",
    "process-sourcemaps:esnext": "embrace-web-cli upload -a NOEMB -p ./dist/esnext/assets --no-upload",
    "process-sourcemaps:es2015": "embrace-web-cli upload -a NOEMB -p ./dist/es2015/assets --no-upload"
  },
  "dependencies": {
    "@embrace-io/web-sdk": "file:../../../..",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@embrace-io/web-cli": "file:../../../../cli",
    "@eslint/js": "^9.29.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "sonda": "^0.8.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.1.2"
  }
}
