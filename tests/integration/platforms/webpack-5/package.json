{
  "name": "webpack-5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "webpack serve --config webpack.config.es2015.mjs --mode development",
    "build": "npm run build:clean && npm run build:es2015",
    "build:clean": "emb-rm dist .sonda",
    "build:es2015": "webpack --config webpack.config.es2015.mjs --mode production && npm run process-sourcemaps",
    "process-sourcemaps": "embrace-web-cli upload -a NOEMB -p ./dist/es2015 --no-upload"
  },
  "dependencies": {
    "@embrace-io/web-sdk": "file:../../../../packages/web-sdk",
    "@opentelemetry/sdk-logs": "^0",
    "@opentelemetry/sdk-trace-web": "^2",
    "react": "^19",
    "react-dom": "^19"
  },
  "overrides": {
    "lodash": "~4.17.21"
  },
  "devDependencies": {
    "@embrace-io/web-cli": "file:../../../../packages/web-cli",
    "@babel/core": "^7",
    "@babel/preset-env": "^7",
    "@babel/preset-react": "^7",
    "@babel/preset-typescript": "^7",
    "babel-loader": "^10",
    "html-webpack-plugin": "^5",
    "sonda": "^0",
    "webpack": "^5",
    "webpack-cli": "^6",
    "webpack-dev-server": "^5",
    "webpack-merge": "^6"
  }
}
