{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "webpack serve --config webpack.config.esnext.mjs --mode development",
    "build": "npm run build:clean && npm run build:esnext && npm run build:es2015",
    "build:clean": "npx rimraf dist .sonda",
    "build:esnext": "webpack --config webpack.config.esnext.mjs --mode production && npm run process-sourcemaps:esnext",
    "build:es2015": "webpack --config webpack.config.es2015.mjs --mode production && npm run process-sourcemaps:es2015",
    "process-sourcemaps:esnext": "npm run embrace-web-cli -- upload -a NOEMB -p ./dist/esnext --no-upload",
    "process-sourcemaps:es2015": "npm run embrace-web-cli -- upload -a NOEMB -p ./dist/es2015 --no-upload",
    "embrace-web-cli": "embrace-web-cli"
  },
  "dependencies": {
    "@embrace-io/web-sdk": "file:../../../..",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@embrace-io/web-cli": "file:../../../../cli",
    "@babel/core": "^7.27.7",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "babel-loader": "^10.0.0",
    "sonda": "^0.8.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^6.0.1"
  }
}
