    "babel-loader": "^8.4.1",
    "html-loader": "^1.3.2",
    "html-webpack-plugin": "^4.5.2",
    "webpack": "^4.47.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.15.2"
