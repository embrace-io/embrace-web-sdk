# Shared external version pins, read by the Makefile and CI. Each `# renovate:` comment lets
# Renovate bump the pin below it, when the repo's Renovate config has a match string for it;
# without Renovate they do nothing.
# A registry's own release version is NOT pinned here: it is the last segment of the schema_url in
# the registry's manifest.yaml, and the registries it depends on are pinned in that manifest too.

# renovate: datasource=github-releases depName=open-telemetry/weaver versioning=semver-coerced
WEAVER_VERSION=v0.26.1

# Renovate, for validating the Renovate config locally and in the Renovate Config Validator
# workflow. The workflow prefers the version the hosted Renovate app last ran, read from the footer
# of its latest pull request, and uses this pin only when it can't read one. Keep it at the
# version the app ran most recently (the footer's `updatedInVer`), not at the newest release, so
# the fallback checks the config the way the app does. Not bumped by Renovate on purpose.
RENOVATE_VERSION=44.112.0
