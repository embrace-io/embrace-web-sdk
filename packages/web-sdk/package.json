{
  "name": "@embrace-io/web-sdk",
  "version": "2.33.0",
  "description": "Embrace Web SDK",
  "type": "module",
  "jsdelivr": "./dist/embrace-web-sdk.js",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "emb-rm dist .sonda",
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "test": "web-test-runner",
    "test:watch": "npm run test -- --watch",
    "test:manual": "npm run test -- --manual",
    "test:coverage": "npm run test -- --config=web-test-runner.coverage.config.js",
    "test:multiBrowsers": "npm run test -- --config=web-test-runner.multi-browser.config.js",
    "check": "tsc -p tsconfig.check.json && eslint --max-warnings 0",
    "check:dist": "eslint --max-warnings 0 --config eslint.dist.config.ts",
    "validate": "node scripts/validate.ts",
    "docs": "npx typedoc --readme none && touch docs/.nojekyll",
    "licenses": "generate-license-file"
  },
  "files": [
    "*.md",
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./react-instrumentation": "./dist/react-instrumentation/index.js",
    "./package.json": "./package.json"
  },
  "author": "Embrace <support@embrace.io> (https://embrace.io/)",
  "bugs": {
    "url": "https://github.com/embrace-io/embrace-web-sdk/issues",
    "email": "support@embrace.io"
  },
  "homepage": "https://github.com/embrace-io/embrace-web-sdk",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embrace-io/embrace-web-sdk.git",
    "directory": "packages/web-sdk"
  },
  "keywords": [
    "embrace",
    "web",
    "tracking",
    "observability",
    "otel",
    "instrumentation",
    "telemetry"
  ],
  "dependencies": {
    "@opentelemetry/api": ">=1.10.0 <1.11.0",
    "@opentelemetry/browser-api": "^0.2.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-fetch": "^0.301.2",
    "@opentelemetry/instrumentation-xml-http-request": "^0.301.2",
    "@opentelemetry/otlp-exporter-base": "^0.301.2",
    "@opentelemetry/otlp-transformer": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "hoist-non-react-statics": "^3.3.2",
    "web-vitals": "^6.2.3"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
