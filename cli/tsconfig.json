{
  "compilerOptions": {
    "outDir": "build",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "strict": true,
    "rootDir": "src"
  },
  "include": ["./src/**/*.ts"]
}
