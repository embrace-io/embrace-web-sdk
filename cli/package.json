{
  "name": "@embrace-io/web-cli",
  "bin": {
    "embrace-web-cli": "dist/index.mjs"
  },
  "version": "2.10.0",
  "description": "Embrace Web CLI for uploading sourcemaps and versioning bundles",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "npx rimraf dist",
    "compile": "npm run clean && tsc && tsdown",
    "test": "tsx --test src/**/*.test.ts",
    "validate": "tsx scripts/validate-cli.ts"
  },
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/embrace-io/embrace-web-sdk/issues",
    "email": "support@embrace.io"
  },
  "homepage": "https://github.com/embrace-io/embrace-web-sdk",
  "author": "Embrace <support@embrace.io> (https://embrace.io/)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embrace-io/embrace-web-sdk.git",
    "directory": "cli"
  },
  "keywords": [
    "embrace",
    "web",
    "tracking",
    "observability",
    "instrumentation",
    "telemetry",
    "otel",
    "cli"
  ],
  "dependencies": {
    "commander": "14.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
